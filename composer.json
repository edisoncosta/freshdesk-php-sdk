{
    "name": "keepcloud/freshdesk-php-sdk",
    "description": "PHP SDK for the Freshdesk API (v2)",
    "type": "library",
    "homepage": "https://github.com/keepcloud/freshdesk-php-sdk",
    "keywords": [
        "freshdesk",
        "customer service",
        "support",
        "help desk",
        "api"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Clarkson",
            "email": "mpclarkson@hilenium.com",
            "homepage": "http://mpclarkson.github.io/"
        },
        {
            "name": "Edison Costa",
            "email": "edison@keepcloud.io",
            "homepage": "https://keepcloud.io/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Freshdesk\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Freshdesk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
